# Reference copy of Eskiz live TLS vhost (77-83-206-192.sslip.io).
# Keep HTML uncached so Electron/desktop picks up new Expo entry hashes after deploy.
#
# Required API proxy (already on VPS):
#   location /api/ { proxy_pass http://127.0.0.1:5000; ... }
# Optional short CASHBACK.exe base (same upstream as /api):
#   location ^~ /fom-cashback/ {
#       proxy_pass http://127.0.0.1:5000/fom-cashback/;
#       proxy_http_version 1.1;
#       proxy_set_header Host $host;
#       proxy_set_header X-Real-IP $remote_addr;
#       proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
#       proxy_set_header X-Forwarded-Proto $scheme;
#   }
# Prefer giving FOM:
#   https://77-83-206-192.sslip.io/api/integrations/fom/cashback
#   https://77-83-206-192.sslip.io/api/integrations/fom/site-xml?token=<FOM_WEBHOOK_SECRET>

# ... ssl + /api/ + /uploads/ + /admin as on the VPS ...

    location ^~ /_expo/ {
        expires 1y;
        add_header Cache-Control "public, max-age=31536000, immutable" always;
        try_files $uri =404;
    }

    location ^~ /sw.js {
        add_header Cache-Control "no-cache, no-store, must-revalidate" always;
        add_header Pragma "no-cache" always;
        try_files $uri =404;
    }

    location / {
        try_files $uri $uri/ /index.html;
        add_header Cache-Control "no-cache, no-store, must-revalidate" always;
        add_header Pragma "no-cache" always;
    }
