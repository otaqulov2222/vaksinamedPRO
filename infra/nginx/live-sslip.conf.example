# Reference copy of Eskiz live TLS vhost (77-83-206-192.sslip.io).
# Keep HTML uncached so Electron/desktop picks up new Expo entry hashes after deploy.

# ... ssl + /api/ + /uploads/ + /admin as on the VPS ...

    location ^~ /_expo/ {
        expires 1y;
        add_header Cache-Control "public, max-age=31536000, immutable" always;
        try_files $uri =404;
    }

    location ^~ /sw.js {
        add_header Cache-Control "no-cache, no-store, must-revalidate" always;
        add_header Pragma "no-cache" always;
        try_files $uri =404;
    }

    location / {
        try_files $uri $uri/ /index.html;
        add_header Cache-Control "no-cache, no-store, must-revalidate" always;
        add_header Pragma "no-cache" always;
    }
