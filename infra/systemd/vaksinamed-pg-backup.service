[Unit]
Description=VaksinaMed PostgreSQL logical backup
After=postgresql.service
Wants=postgresql.service

[Service]
Type=oneshot
User=root
Nice=10
Environment=BACKUP_DIR=/var/backups/vaksinamed/pg
Environment=DB_NAME=vaksinamed_staging
Environment=RETENTION_DAYS=7
ExecStart=/usr/local/bin/vaksinamed-pg-backup.sh
