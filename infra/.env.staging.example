# VaksinaMed Staging Environment Variables Template
# Copy to /opt/vaksinamed/.env.staging on the Hetzner Staging host.
# Permissions: chmod 600 /opt/vaksinamed/.env.staging (owned by deployer)
# NEVER commit real secret values to Git!

# Core Application Settings
APP_ENV=staging
NODE_ENV=production
PORT=5000

# PostgreSQL 16 (internal Docker network credentials)
POSTGRES_USER=vaksinamed_staging_user
POSTGRES_PASSWORD=REPLACE_WITH_STRONG_RANDOM_POSTGRES_PASSWORD

# Redis 7.2 (internal Docker network password)
REDIS_PASSWORD=REPLACE_WITH_STRONG_RANDOM_REDIS_PASSWORD

# Auth & HMAC Secrets (P2 fail-closed — boot will abort if missing)
ADMIN_SECRET=REPLACE_WITH_STRONG_RANDOM_ADMIN_SECRET_MIN_32_CHARS
CUSTOMER_SECRET=REPLACE_WITH_STRONG_RANDOM_CUSTOMER_SECRET_MIN_32_CHARS
POS_SECRET=REPLACE_WITH_STRONG_RANDOM_POS_SECRET_MIN_32_CHARS

# Merchant Key Encryption Key (32 bytes base64 or 64 hex chars)
MERCHANT_SECRET_KEK=REPLACE_WITH_GENERATED_32_BYTE_BASE64_KEY

# FOM Webhook Authentication (Shared HMAC)
FOM_WEBHOOK_SECRET=REPLACE_WITH_FOM_SHARED_SECRET

# CORS Configuration (exact HTTPS origin, no wildcards)
CORS_ORIGIN=https://admin.staging.vaksinamed.uz

# External Payment Providers (0 = disabled until sandbox keys active)
PAYME_MERCHANT_API_ENABLED=0
CLICK_MERCHANT_API_ENABLED=0

# Eskiz SMS Provider (optional in initial staging, required for live OTP)
ESKIZ_EMAIL=
ESKIZ_PASSWORD=
ESKIZ_FROM=4546

# Worker Concurrency Settings
PG_POOL_MAX=20
WORKER_POLL_INTERVAL_MS=15000
WORKER_STALE_RUNNING_MS=1800000
