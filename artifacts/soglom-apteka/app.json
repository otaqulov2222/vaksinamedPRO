{
  "expo": {
    "name": "Vaksina Med",
    "slug": "vaksina-med",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "vaksinamed",
    "userInterfaceStyle": "automatic",
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "uz.vaksinamed.app",
      "buildNumber": "1",
      "infoPlist": {
        "NSLocationWhenInUseUsageDescription": "Eng yaqin Vaksina Med filialini topish uchun joylashuvingiz kerak.",
        "NSCameraUsageDescription": "Retsept rasmini yuklash uchun kameraga ruxsat kerak.",
        "NSPhotoLibraryUsageDescription": "Retsept rasmini galereyadan tanlash uchun ruxsat kerak."
      }
    },
    "android": {
      "package": "uz.vaksinamed.app",
      "versionCode": 1,
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/icon.png",
        "backgroundColor": "#5C328E"
      },
      "permissions": [
        "ACCESS_COARSE_LOCATION",
        "ACCESS_FINE_LOCATION",
        "CAMERA",
        "READ_MEDIA_IMAGES"
      ]
    },
    "web": {
      "favicon": "./assets/images/icon.png",
      "bundler": "metro",
      "output": "static"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#F8F5FF",
          "image": "./assets/images/brand-symbol.png",
          "imageWidth": 160,
          "resizeMode": "contain"
        }
      ],
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "Eng yaqin Vaksina Med filialini va yo‘lni ko‘rsatish uchun joylashuvingiz kerak."
        }
      ],
      [
        "expo-image-picker",
        {
          "cameraPermission": "Retsept rasmini yuklash uchun kameraga ruxsat kerak.",
          "photosPermission": "Retsept rasmini galereyadan tanlash uchun ruxsat kerak."
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "eas": {
        "projectId": "vaksina-med-loyalty"
      },
      "telegramMiniApp": true,
      "storeReady": false,
      "privacyPolicyUrl": "https://77-83-206-192.sslip.io/privacy",
      "termsOfUseUrl": "https://77-83-206-192.sslip.io/terms"
    }
  }
}
