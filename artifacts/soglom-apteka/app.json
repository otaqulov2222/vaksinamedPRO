{
  "expo": {
    "name": "Vaksina Med",
    "slug": "vaksina-med",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "vaksinamed",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "uz.vaksinamed.app",
      "buildNumber": "1",
      "infoPlist": {
        "NSLocationWhenInUseUsageDescription": "Eng yaqin Vaksina Med filialini topish uchun joylashuvingiz kerak.",
        "NSCameraUsageDescription": "Retsept rasmini yuklash uchun kameraga ruxsat kerak.",
        "NSPhotoLibraryUsageDescription": "Retsept rasmini galereyadan tanlash uchun ruxsat kerak."
      }
    },
    "android": {
      "package": "uz.vaksinamed.app",
      "versionCode": 14,
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/adaptive-icon.png",
        "backgroundColor": "#FFFFFF"
      },
      "softwareKeyboardLayoutMode": "resize",
      "permissions": [
        "ACCESS_COARSE_LOCATION",
        "ACCESS_FINE_LOCATION",
        "CAMERA",
        "READ_MEDIA_IMAGES",
        "POST_NOTIFICATIONS"
      ]
    },
    "androidNavigationBar": {
      "backgroundColor": "#FFFFFF",
      "barStyle": "dark-content"
    },
    "newArchEnabled": true,
    "web": {
      "favicon": "./assets/images/icon.png",
      "bundler": "metro",
      "output": "static"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#FFFFFF",
          "image": "./assets/images/brand-symbol.png",
          "imageWidth": 120,
          "resizeMode": "contain"
        }
      ],
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "Eng yaqin Vaksina Med filialini va yo‘lni ko‘rsatish uchun joylashuvingiz kerak."
        }
      ],
      [
        "expo-image-picker",
        {
          "cameraPermission": "Retsept rasmini yuklash uchun kameraga ruxsat kerak.",
          "photosPermission": "Retsept rasmini galereyadan tanlash uchun ruxsat kerak."
        }
      ],
      [
        "expo-notifications",
        {
          "icon": "./assets/images/icon.png",
          "color": "#4B248A",
          "defaultChannel": "default"
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    },
    "owner": "saydirasulovs-team",
    "extra": {
      "eas": {
        "projectId": "b151fef6-ede6-4ff4-be2c-f2bff93929ac"
      },
      "telegramMiniApp": true,
      "storeReady": false,
      "privacyPolicyUrl": "https://77-83-206-192.sslip.io/privacy",
      "termsOfUseUrl": "https://77-83-206-192.sslip.io/terms"
    }
  }
}
