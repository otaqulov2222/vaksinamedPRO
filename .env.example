# Vaksina Med — environment placeholders (P1 + P2)
# Copy to .env locally — NEVER commit .env or real secrets.

# ---------------------------------------------------------------------------
# Database
# ---------------------------------------------------------------------------
# Production / staging: REQUIRED managed PostgreSQL (PGlite is NOT production).
DATABASE_URL=postgresql://user:pass@localhost:5432/vaksinamed

# Isolated test database (name MUST contain "test", e.g. vaksinamed_test).
# TEST_DATABASE_URL=postgresql://user:pass@localhost:5432/vaksinamed_test

# Optional driver override: postgres | pglite
# DB_DRIVER=

# PGlite local demo directory (development only)
# PGLITE_DIR=.data/pglite

# Demo seed: never used in production/staging/test.
# PGlite development seeds by default.
# Postgres development requires:
# ALLOW_DEMO_SEED=1

# Emergency local only — never in production:
# ALLOW_DRIZZLE_PUSH_FORCE=1
# ALLOW_DESTRUCTIVE_DB=1
# ALLOW_TEST_DB=1

# ---------------------------------------------------------------------------
# Runtime
# ---------------------------------------------------------------------------
PORT=5000
# development | test | staging | production
APP_ENV=development
NODE_ENV=development

# Required in staging/production (no code fallbacks):
ADMIN_SECRET=change-me-admin
CUSTOMER_SECRET=change-me-customer
POS_SECRET=change-me-pos-qr

# FOM webhook shared secret (required in production/staging)
# FOM_WEBHOOK_SECRET=change-me-fom-webhook

# ---------------------------------------------------------------------------
# P2 development-only security flags (NEVER set in production/staging)
# ---------------------------------------------------------------------------
# ALLOW_OTP_DEV_BYPASS=1
#   Enables: OTP 000000, API devCode, SMS console OTP body, demo phone login
# ALLOW_PAYMENT_SIMULATE=1
#   Enables mock payment HTML + POST /payments/:id/simulate-success
# ALLOW_TELEGRAM_AUTO_PROVISION=1
#   Allows creating customers from x-telegram-id (non-prod only)

# ---------------------------------------------------------------------------
# P7.6.3 Payme (Paycom) Merchant API — no secrets here; keys live on branches
# ---------------------------------------------------------------------------
# PAYME_MERCHANT_API_ENABLED=1
#   Required in production/staging to accept Payme JSON-RPC at /api/payments/payme/merchant
# PAYME_CHECKOUT_BASE_URL=https://checkout.test.paycom.uz
#   Override checkout host (defaults: test host in non-prod; prod host only with PAYME_LIVE=1)
# PAYME_LIVE=1
#   Allow https://checkout.paycom.uz in production-like when base URL unset
# Sandbox console: https://test.paycom.uz/
# Merchant billing URL to register with Payme: {API}/api/payments/payme/merchant
# Account field for cashbox: order_id (= orders.id)

# ---------------------------------------------------------------------------
# P7.6.4 Click Shop API — no secrets here; keys live on branches
# ---------------------------------------------------------------------------
# CLICK_MERCHANT_API_ENABLED=1
#   Required in production/staging to accept Prepare/Complete at /api/payments/click/merchant
# CLICK_CHECKOUT_BASE_URL=https://my.click.uz/services/pay
#   Override checkout URL (defaults: my.click.uz in non-prod; prod host only with CLICK_LIVE=1)
# CLICK_LIVE=1
#   Allow https://my.click.uz/services/pay in production-like when base URL unset
# Merchant billing URLs to register with Click:
#   Prepare/Complete: {API}/api/payments/click/merchant
# merchant_trans_id = orders.id (or payment intent id / pi:{id})
# Docs: https://docs.click.uz/ (Shop API Prepare/Complete + click-button)

# ---------------------------------------------------------------------------
# SMS (Eskiz) — required for real OTP in production
# ---------------------------------------------------------------------------
# ESKIZ_EMAIL=your@email.com
# ESKIZ_PASSWORD=your-eskiz-password
# ESKIZ_FROM=4546

# ---------------------------------------------------------------------------
# P3 sessions / dual-accept migration
# ---------------------------------------------------------------------------
# New logins issue revocable s1.* sessions (PostgreSQL auth_sessions).
# Legacy HMAC tokens are dual-accepted until you close the window:
# ALLOW_LEGACY_HMAC_TOKENS=0
#   Immediately reject legacy HMAC (session tokens only)
# LEGACY_HMAC_DEADLINE=2026-10-21T00:00:00.000Z
#   Accept legacy HMAC only until this ISO timestamp
# Recommended: set LEGACY_HMAC_DEADLINE at deploy (≤ one client release cycle),
# then set ALLOW_LEGACY_HMAC_TOKENS=0 after clients refresh.
# Unset = dual-accept remains on (mobile compatibility; residual risk until closed).
#
# Rate limiting: in-memory only (not multi-instance safe). Redis deferred.

# ---------------------------------------------------------------------------
# P10 background workers (PostgreSQL worker_jobs — no BullMQ invent)
# ---------------------------------------------------------------------------
# ENABLE_BACKGROUND_WORKERS=1
#   Ops: allow /workers/run-due and /workers/enqueue in production-like.
#   Process boot never starts a worker loop.
# ENABLE_BACKGROUND_WORKERS_DEV=1
#   Non-prod convenience enable
# PAYMENT_INTENT_TTL_MS=1800000
#   Unpaid payment intent expiry for worker:payment_expiry (default 30m)
# EXTERNAL_DELIVERY_ENABLED=0
#   External delivery remains CONTRACT_PENDING — do not set to invent a provider

# ---------------------------------------------------------------------------
# SMS (Eskiz) — required for real OTP in production
# ---------------------------------------------------------------------------
# ESKIZ_EMAIL=your@email.com
# ESKIZ_PASSWORD=your-eskiz-password
# ESKIZ_FROM=4546

# Optional absolute path if migrations cannot be auto-discovered from cwd:
# DB_MIGRATIONS_FOLDER=C:/path/to/lib/db/migrations

# ---------------------------------------------------------------------------
# Sandbox E2E harness (staging only — never commit real values)
# ---------------------------------------------------------------------------
# PAYME_SANDBOX_KEY=
# PAYME_SANDBOX_MERCHANT_ID=
# CLICK_SANDBOX_SECRET=
# CLICK_SANDBOX_SERVICE_ID=
# CLICK_SANDBOX_MERCHANT_ID=
# SANDBOX_E2E_RUN=1
#   Explicit opt-in to attempt live network E2E (requires test DB + staging callbacks)
# Run: pnpm sandbox:e2e
# Honest result without credentials: PAYME_SANDBOX_E2E_PENDING / CLICK_SANDBOX_E2E_PENDING

# ---------------------------------------------------------------------------
# P13 real PostgreSQL load + HTTP (staging only — never production)
# ---------------------------------------------------------------------------
# REAL_POSTGRES_LOAD_TEST=1
# TEST_DATABASE_URL=postgresql://user:pass@localhost:55432/vaksinamed_p13_test
# PG_POOL_MAX=40
# Docker: docker compose --profile p13 up -d postgres
# Run: pnpm p13:load
# Without real PG: REAL_PG_LOAD_PENDING (honest — not PASS)
# P13_API_BASE_URL=https://staging.example.com
#   Required for HTTP load PASS (ready.driver must be postgres)
# P13_HTTP_ALLOW_PGLITE_SMOKE=1
#   Optional local smoke only — NOT accepted as PASS evidence
# Run: pnpm p13:http

# Expo / mobile API base (local)
EXPO_PUBLIC_API_URL=http://localhost:5000
